# --- Step 1: New episode detection & transcript scraping ---

# WSJ "Tech News Briefing" podcast RSS feed.
# Found via public search (Megaphone-hosted feed, mirrored on Panoply under the
# same show id WSJ8523681216). This sandbox's network egress is locked down,
# so the URL could NOT be live-verified from here — confirm it once from a
# machine with normal internet access before relying on it:
#   curl -I https://feeds.megaphone.fm/WSJ8523681216
# If it 404s/redirects, get the current link from the podcast app's
# "Copy RSS Link" / share option for WSJ Tech News Briefing and paste it here.
RSS_FEED_URL=https://feeds.megaphone.fm/WSJ8523681216

# Fallback/alternate podcast page used only for reference; episode page URLs
# normally come from the RSS <link> of each item.
WSJ_SHOW_PAGE_URL=https://www.wsj.com/podcasts/tech-news-briefing

# Where state (last-seen episode) and scraped transcripts are written.
STATE_FILE_PATH=./data/state.json
TRANSCRIPTS_DIR=./data/transcripts

# HTTP behavior
HTTP_TIMEOUT_MS=15000
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# Polling interval (minutes) used by `npm run watch`
POLL_INTERVAL_MINUTES=30

# --- Step 2: DeepL translation ---

# DeepL API key. Free plan keys end with ":fx" (auto-selects the free API
# endpoint below); Pro plan keys don't have that suffix.
DEEPL_API_KEY=

# Optional manual override; auto-detected from the DEEPL_API_KEY suffix if unset.
#   Free: https://api-free.deepl.com/v2/translate
#   Pro:  https://api.deepl.com/v2/translate
DEEPL_API_URL=

# --- Step 2: Gmail API (OAuth2 "installed app" flow) ---

# From Google Cloud Console: enable the Gmail API, then create an OAuth
# client ID of type "Desktop app" and paste its id/secret below.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Obtained by running `npm run gmail:auth` once (see README "Step 2" section).
GMAIL_REFRESH_TOKEN=

# Must match the redirect URI registered on the OAuth client above.
GMAIL_REDIRECT_URI=http://localhost:53682/oauth2callback

# The Gmail address the OAuth token was issued for (used as the "From:").
GMAIL_SENDER=

# Where to send the translated transcript. Comma-separate multiple addresses.
MAIL_TO=the.slg.firefly@gmail.com
