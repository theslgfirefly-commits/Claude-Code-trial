{
  "name": "wsj-tnb-notifier",
  "version": "0.1.0",
  "description": "WSJ Tech News Briefing: new episode detection, transcript translation & notification, and a loop-playback web player.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "ts-node src/index.ts",
    "watch": "ts-node src/index.ts --watch",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "gmail:auth": "ts-node src/getGmailRefreshToken.ts",
    "serve": "ts-node src/server.ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "googleapis": "^174.0.1",
    "nodemailer": "^9.0.5",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
